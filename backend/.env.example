GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
BROWSER_HEADLESS=false

# --- Twilio phone integration ---
# Auth Token from https://console.twilio.com — verifies incoming /twilio/*
# webhook requests genuinely came from Twilio. Unset = verification skipped
# (fine for local dev with ngrok, unsafe in production).
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Only needed for outbound calls/texts later (e.g. the planned SMS
# customer-approval feature) — not required just to receive calls.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_PHONE_NUMBER=+15555550100

# Public HTTPS URL Twilio can reach this backend on, so it can POST to
# /twilio/voice and /twilio/gather and fetch generated reply audio from
# /twilio/audio/*.mp3. In dev, your ngrok URL; in prod, your real domain.
#   PUBLIC_BASE_URL=https://a1b2c3d4.ngrok-free.app
PUBLIC_BASE_URL=
